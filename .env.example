# Sahabat Kreator - Environment Variables
# Copy this file to .env and fill in the values

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/sahabatkreator

# ── Auth (Better Auth) ────────────────────────────────────────────
BETTER_AUTH_SECRET=your-secret-key-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# ── VAPID Keys (Web Push Notifications) ───────────────────────────
# Generate with: bunx --yes vapid --output json
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_PUBLIC_KEY=your-vapid-public-key-here
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# ── Upstash Redis (job queue, rate limit) ─────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Local Redis (BullMQ fallback) ─────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Cloudflare R2 (object storage) ────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── Security ──────────────────────────────────────────────────────
ENCRYPTION_KEY=your-32-char-minimum-encryption-key-for-oauth-tokens

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Resend (email) ────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@sahabatkreator.id

# ── SumoPod Pay ───────────────────────────────────────────────────
SUMOPOD_API_KEY=
SUMOPOD_API_SECRET=
SUMOPOD_WEBHOOK_SECRET=
SUMOPOD_WEBHOOK_TOKEN=
SUMOPOD_BASE=https://api.sumopod.com

# ── AI / OpenRouter ──────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── SK AI Advisor ────────────────────────────────────────────────
SK_MODEL=
SK_SYSTEM_PROMPT_OVERRIDE=
SK_TEMPERATURE=
SK_MAX_REPORTS_PER_DAY=10
SK_MAX_CHATS_PER_DAY=50

# ── Runtime ───────────────────────────────────────────────────────
NODE_ENV=development
