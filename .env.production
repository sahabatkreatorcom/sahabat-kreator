# Sahabat Kreator - Production Environment
# ⚠️  NEVER commit this file to git. Copy from .env.example and fill in real values.

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# For managed PostgreSQL (e.g., Supabase, Railway, AWS RDS):
DATABASE_URL=postgresql://user:password@host:5432/sahabatkreator
# Or for local Docker deployment:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sahabatkreator

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=your-production-secret-at-least-32-chars
BETTER_AUTH_URL=https://api.sahabatkreator.com
NEXT_PUBLIC_SERVER_URL=https://api.sahabatkreator.com
CORS_ORIGIN=https://sahabatkreator.com

# ── VAPID Keys (Web Push Notifications) ───────────────────────────────────────
# Generate with: bunx --yes vapid --output json
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_PUBLIC_KEY=your-vapid-public-key-here
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# ── Upstash Redis (Job Queue & Rate Limiting) ─────────────────────────────────
# Get credentials from https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ── Local Redis (if not using Upstash) ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ── Cloudflare R2 (Object Storage for Media) ──────────────────────────────────
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=sahabatkreator-media

# ── Security ──────────────────────────────────────────────────────────────────
# 32+ char string for encrypting stored OAuth tokens
ENCRYPTION_KEY=your-32-char-minimum-encryption-key-for-oauth-tokens

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Disable pretty printing in production
PINO_PRETTY=false

# ── Resend (Email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@sahabatkreator.id

# ── SumoPod Pay (Payment Gateway) ─────────────────────────────────────────────
SUMOPOD_API_KEY=your-sumopod-api-key
SUMOPOD_API_SECRET=your-sumopod-api-secret
SUMOPOD_WEBHOOK_SECRET=your-sumopod-webhook-secret
SUMOPOD_WEBHOOK_TOKEN=your-sumopod-webhook-token
SUMOPOD_BASE=https://api.sumopod.com

# ── AI / OpenRouter ───────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key

# ── SK AI Advisor ─────────────────────────────��───────────────────────────────
SK_MODEL=gpt-4o-mini
SK_SYSTEM_PROMPT_OVERRIDE=
SK_TEMPERATURE=0.7
SK_MAX_REPORTS_PER_DAY=10
SK_MAX_CHATS_PER_DAY=50

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
