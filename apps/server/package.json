{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "test": "vitest run --passWithNoTests",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@hono/zod-openapi": "^1.6.1",
    "@sahabatkreator/api": "workspace:*",
    "@sahabatkreator/auth": "workspace:*",
    "@sahabatkreator/db": "workspace:*",
    "@sahabatkreator/env": "workspace:*",
    "@sahabatkreator/jobs": "workspace:*",
    "@sahabatkreator/payment": "workspace:*",
    "@sahabatkreator/platform": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.16",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "better-auth": "catalog:",
    "bullmq": "^5.81.2",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "hono": "catalog:",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^4.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sahabatkreator/config": "workspace:*",
    "@types/bun": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "jsdom": "catalog:",
    "pino-pretty": "^13.1.3",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  }
}
