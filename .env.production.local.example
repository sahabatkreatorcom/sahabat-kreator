# Sahabat Kreator - Production Environment (Local Copy)
# ⚠️  DO NOT COMMIT THIS FILE
# Copy values from .env.production

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_PG_PASSWORD@localhost:5432/sahabatkreator
PGUSER=postgres
PGPASSWORD=YOUR_PG_PASSWORD
PGDATABASE=sahabatkreator

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=YOUR_GENERATED_SECRET_HERE
BETTER_AUTH_URL=https://api.sahabatkreator.com
NEXT_PUBLIC_SERVER_URL=https://api.sahabatkreator.com
CORS_ORIGIN=https://sahabatkreator.com
NEXT_PUBLIC_APP_URL=https://sahabatkreator.com

# ── VAPID Keys (Web Push Notifications) ───────────────────────────────────────
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# ── Cloudflare R2 (Object Storage) ────────────────────────────────────────────
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_KEY
R2_BUCKET_NAME=sahabatkreator-media

# ── Security ──────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=YOUR_32_CHAR_ENCRYPTION_KEY

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=YOUR_RESEND_KEY
RESEND_FROM_EMAIL=noreply@sahabatkreator.com

# ── SumoPod Pay ───────────────────────────────────────────────────────────────
SUMOPOD_API_KEY=YOUR_SUMOPOD_KEY
SUMOPOD_API_SECRET=YOUR_SUMOPOD_SECRET
SUMOPOD_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
SUMOPOD_WEBHOOK_TOKEN=YOUR_WEBHOOK_TOKEN
SUMOPOD_BASE=https://api.sumopod.com

# ── AI / OpenRouter ───────────────────────────────────────────────────────────
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY

# ── SK AI Advisor ─────────────────────────────────────────────────────────────
SK_MODEL=gpt-4o-mini
SK_SYSTEM_PROMPT_OVERRIDE=
SK_TEMPERATURE=0.7
SK_MAX_REPORTS_PER_DAY=10
SK_MAX_CHATS_PER_DAY=50

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
PINO_PRETTY=false
